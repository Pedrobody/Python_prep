{
  "name": "BCG X - Data Science Mock Assessment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install -r requirements.txt && python -m pytest --collect-only -q",
  "postStartCommand": "python start_practice.py",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "Python Lab", "onAutoForward": "openBrowser"}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    }
  }
}
